# Top-most EditorConfig file
root = true

[*.cs]
# Indentation and spacing
indent_style = space
indent_size = 4
tab_width = 4
# Enforce braces only for multi-line control flow blocks
csharp_prefer_braces = when_multiline:warning

# File-scoped namespaces (enforces namespace MyNamespace; without braces)
csharp_style_namespace_declarations = file_scoped:warning

# K&R Brace Style (forces open braces on the same line)
csharp_new_line_before_open_brace = none